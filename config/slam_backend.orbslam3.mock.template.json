{
  "backend_runner": {
    "backend_name": "mock_orbslam3_monocular",
    "template_variables": {
      "orbslam3_command": "scripts/mock_orbslam3_backend.ps1",
      "orbslam3_workdir": "{backend_root}/orbslam3_mock_runtime",
      "orbslam3_vocabulary_path": "config/camera_calibration.sample.yaml",
      "orbslam3_settings_path": "config/camera_calibration.template.yaml",
      "orbslam3_trajectory_source": "CameraTrajectory.txt",
      "orbslam3_playback_rate": "1.0",
      "orbslam3_startup_delay_sec": "1",
      "orbslam3_post_playback_grace_sec": "5"
    },
    "command": "scripts/run_orbslam3_backend.ps1",
    "arguments": [
      "-BagPath",
      "{bag_root}",
      "-ExperimentName",
      "{experiment_name}",
      "-TrajectoryPath",
      "{trajectory_path}",
      "-RuntimeLogPath",
      "{runtime_log_path}",
      "-BackendCommand",
      "{orbslam3_command}",
      "-VocabularyPath",
      "{orbslam3_vocabulary_path}",
      "-SettingsPath",
      "{orbslam3_settings_path}",
      "-BackendWorkingDirectory",
      "{orbslam3_workdir}",
      "-TrajectorySourcePath",
      "{orbslam3_trajectory_source}",
      "-PlaybackRate",
      "{orbslam3_playback_rate}",
      "-StartupDelaySeconds",
      "{orbslam3_startup_delay_sec}",
      "-PostPlaybackGraceSeconds",
      "{orbslam3_post_playback_grace_sec}"
    ],
    "working_directory": "{experiment_root}",
    "timeout_seconds": 120,
    "trajectory_path": "backend_artifacts/orbslam3/CameraTrajectory.txt",
    "trajectory_format": "tum_pose_v1",
    "map_path": "",
    "runtime_log_path": "backend_artifacts/orbslam3/orbslam3_runtime.log",
    "result_notes": "Smoke configuration for the ORB-SLAM3 adapter layer with TUM trajectory.",
    "allow_failure": false
  }
}
